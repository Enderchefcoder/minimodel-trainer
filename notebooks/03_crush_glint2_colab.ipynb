      "source": [
        "# Crush Glint-2 \u2014 1.4M dense on Colab T4 (one cell)\n",
        "\n",
        "Locked recipe (`research/reports/11_crush_glint2_recipe.md`):\n",
        "\n",
        "- **Model:** `dense_1_4m` (1,406,506 params, GQA + QK-norm + tied + VR)\n",
        "- **Tok:** 4096 byte-BPE\n",
        "- **Mix:** FineWeb-Edu 50% / DCLM-100BT 32% / TinyStories 15% / soft-QA 3%\n",
        "- **Train:** AdamW 3e-3, WSD, seq 512, ~65k tok/step, **\u22644h** wall clock\n",
        "- **Backup:** Google Drive every N steps\n",
        "\n",
        "Runtime \u2192 Change runtime type \u2192 **T4 GPU**. Then run the single cell below."
      ],
      "id": "md0"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "# @title Crush Glint-2 \u2014 one-cell T4 trainer (Drive backup)\n",
        "# Locked recipe: dense_1_4m + FineWeb-Edu/DCLM/TinyStories/soft-QA. See report 11.\n",
        "\n",
        "from __future__ import annotations\n",
        "\n",
        "import json\n",
        "import math\n",
        "import os\n",
        "import shutil\n",
        "import subprocess\n",
        "import sys\n",
        "import time\n",
        "from pathlib import Path\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# Knobs (safe defaults for a free Colab T4 ~4h run)\n",
        "# ---------------------------------------------------------------------------\n",
        "HOURS = 4.0\n",
        "DRIVE_ROOT = Path(\"/content/drive/MyDrive/crush_glint2_1_4m\")\n",
        "WORK = Path(\"/content/crush_glint2\")\n",
        "REPO_URL = \"https://github.com/Enderchefcoder/minimodel-trainer.git\"\n",
        "REPO_BRANCH = \"master"\n",
        "VOCAB = 4096\n",
        "SEQ = 512\n",
        "BATCH = 32\n",
        "ACCUM = 4  # 32*512*4 = 65536 tokens/step\n",
        "LR = 3e-3\n",
        "SAVE_EVERY = 200\n",
        "SOFT_KL_EVERY = 20\n",
        "SOFT_KL_WEIGHT = 0.25\n",
        "TOK_SAMPLE_DOCS = 8000  # docs used to train the byte-BPE\n",
        "STREAM_BUFFER_TOKENS = 2_000_000  # rolling packed buffer before refill\n",
        "MIX = {\"fineweb-edu\": 0.50, \"dclm\": 0.32, \"tinystories\": 0.15, \"soft_qa\": 0.03}\n",
        "SEED = 1337\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# 1) Drive + deps + repo\n",
        "# ---------------------------------------------------------------------------\n",
        "IN_COLAB = Path(\"/content\").exists()\n",
        "if IN_COLAB:\n",
        "    from google.colab import drive  # type: ignore\n",
        "\n",
        "    drive.mount(\"/content/drive\", force_remount=False)\n",
        "    DRIVE_ROOT.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "subprocess.check_call(\n",
        "    [sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"numpy\", \"pyyaml\", \"tqdm\", \"requests\",\n",
        "     \"datasets\", \"huggingface_hub\"]\n",
        ")\n",
        "# torch is preinstalled on Colab; CPU/local fallback installs the wheel.\n",
        "try:\n",
        "    import torch\n",
        "except ImportError:\n",
        "    subprocess.check_call(\n",
        "        [sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"torch\", \"--index-url\",\n",
        "         \"https://download.pytorch.org/whl/cu121\"]\n",
        "    )\n",
        "    import torch\n",
        "\n",
        "WORK.mkdir(parents=True, exist_ok=True)\n",
        "repo_dir = WORK / \"minimodel-trainer\"\n",
        "if not (repo_dir / \"src\").exists():\n",
        "    if repo_dir.exists():\n",
        "        shutil.rmtree(repo_dir)\n",
        "    subprocess.check_call(\n",
        "        [\"git\", \"clone\", \"--depth\", \"1\", \"-b\", REPO_BRANCH, REPO_URL, str(repo_dir)]\n",
        "    )\n",
        "subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"-e\", str(repo_dir)])\n",
        "\n",
        "sys.path.insert(0, str(repo_dir / \"src\"))\n",
        "from minimodel.architectures import build_model\n",
        "from minimodel.datasets.soft_labels import (\n",
        "    align_steps_to_tokenizer,\n",
        "    load_soft_label_dataset,\n",
        "    soft_kl_loss,\n",
        "    write_plain_jsonl,\n",
        ")\n",
        "from minimodel.tokenization import BPETokenizer\n",
        "from minimodel.training.optim import build_optimizer\n",
        "from minimodel.training.schedules import build_scheduler, resolve_warmup\n",
        "\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(f\"device={device}  torch={torch.__version__}  cuda={torch.cuda.get_device_name(0) if device.type=='cuda' else 'n/a'}\")\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# 2) Soft-label corpus on disk (+ Drive mirror)\n",
        "# ---------------------------------------------------------------------------\n",
        "corpus_src = repo_dir / \"research\" / \"data\" / \"corpus\" / \"slm_next_token_dataset.json\"\n",
        "corpus_dir = WORK / \"corpus\"\n",
        "corpus_dir.mkdir(parents=True, exist_ok=True)\n",
        "soft_json = corpus_dir / \"slm_next_token_dataset.json\"\n",
        "soft_jsonl = corpus_dir / \"slm_next_token_qa.jsonl\"\n",
        "if not soft_json.exists():\n",
        "    shutil.copy2(corpus_src, soft_json)\n",
        "if not soft_jsonl.exists():\n",
        "    write_plain_jsonl(soft_jsonl, soft_json)\n",
        "if IN_COLAB:\n",
        "    (DRIVE_ROOT / \"corpus\").mkdir(parents=True, exist_ok=True)\n",
        "    shutil.copy2(soft_json, DRIVE_ROOT / \"corpus\" / soft_json.name)\n",
        "    shutil.copy2(soft_jsonl, DRIVE_ROOT / \"corpus\" / soft_jsonl.name)\n",
        "\n",
        "soft_payload = load_soft_label_dataset(soft_json)\n",
        "soft_entries = soft_payload[\"entries\"]\n",
        "print(f\"soft-label entries={len(soft_entries)}  steps\u2248{soft_payload['stats']['total_predicted_token_steps']}\")\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# 3) Streaming mixture \u2192 text iterator\n",
        "# ---------------------------------------------------------------------------\n",
        "from datasets import load_dataset  # heavy optional dep; installed above\n",
        "\n",
        "\n",
        "def _stream(name: str):\n",
        "    if name == \"fineweb-edu\":\n",
        "        return load_dataset(\"HuggingFaceFW/fineweb-edu\", name=\"sample-10BT\", split=\"train\", streaming=True)\n",
        "    if name == \"dclm\":\n",
        "        return load_dataset(\"HuggingFaceFW/dclm_100BT\", split=\"train\", streaming=True)\n",
        "    if name == \"tinystories\":\n",
        "        return load_dataset(\"roneneldan/TinyStories\", split=\"train\", streaming=True)\n",
        "    raise ValueError(name)\n",
        "\n",
        "\n",
        "def soft_qa_cycle():\n",
        "    while True:\n",
        "        for row in soft_jsonl.open(\"r\", encoding=\"utf-8\"):\n",
        "            yield json.loads(row)[\"text\"]\n",
        "\n",
        "\n",
        "streams = {\n",
        "    \"fineweb-edu\": iter(_stream(\"fineweb-edu\")),\n",
        "    \"dclm\": iter(_stream(\"dclm\")),\n",
        "    \"tinystories\": iter(_stream(\"tinystories\")),\n",
        "    \"soft_qa\": soft_qa_cycle(),\n",
        "}\n",
        "names = list(MIX.keys())\n",
        "weights = [MIX[n] for n in names]\n",
        "rng = torch.Generator().manual_seed(SEED)\n",
        "\n",
        "\n",
        "def next_doc() -> str:\n",
        "    idx = int(torch.multinomial(torch.tensor(weights), 1, generator=rng).item())\n",
        "    name = names[idx]\n",
        "    if name == \"soft_qa\":\n",
        "        return next(streams[name])\n",
        "    while True:\n",
        "        row = next(streams[name])\n",
        "        text = (row.get(\"text\") or \"\").strip()\n",
        "        if len(text) >= 64:\n",
        "            return text\n",
        "\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# 4) Train tokenizer on a mix sample (or resume from Drive)\n",
        "# ---------------------------------------------------------------------------\n",
        "tok_path = WORK / \"tokenizer.json\"\n",
        "drive_tok = DRIVE_ROOT / \"tokenizer.json\" if IN_COLAB else None\n",
        "if drive_tok and drive_tok.exists() and not tok_path.exists():\n",
        "    shutil.copy2(drive_tok, tok_path)\n",
        "if tok_path.exists():\n",
        "    tok = BPETokenizer.load(tok_path)\n",
        "    print(\"loaded tokenizer\", tok)\n",
        "else:\n",
        "    print(f\"training byte-BPE vocab={VOCAB} on {TOK_SAMPLE_DOCS} docs\u2026\")\n",
        "    sample = [next_doc() for _ in range(TOK_SAMPLE_DOCS)]\n",
        "    # Ensure soft-QA is in the tokenizer sample.\n",
        "    sample.extend(json.loads(l)[\"text\"] for l in soft_jsonl.read_text(encoding=\"utf-8\").splitlines() if l)\n",
        "    tok = BPETokenizer.train(sample, vocab_size=VOCAB)\n",
        "    tok.save(tok_path)\n",
        "    if IN_COLAB:\n",
        "        shutil.copy2(tok_path, drive_tok)\n",
        "    print(tok, \"bytes/token\u2248\", round(tok.compression_ratio(sample[:64]), 2))\n",
        "\n",
        "encode = lambda s: tok.encode(s, add_bos=False, add_eos=False)  # noqa: E731\n",
        "\n",
        "# Pre-align soft steps once (re-used for KL).\n",
        "aligned_soft = []\n",
        "for entry in soft_entries:\n",
        "    aligned_soft.extend(align_steps_to_tokenizer(entry, encode))\n",
        "print(f\"aligned soft steps={len(aligned_soft)}\")\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# 5) Model + optim + schedule\n",
        "# ---------------------------------------------------------------------------\n",
        "model = build_model(\"dense_1_4m\", overrides={\"vocab_size\": tok.vocab_size}).to(device)\n",
        "n_params = model.num_parameters()\n",
        "assert abs(n_params - 1_406_506) < 50_000 or tok.vocab_size != 4096, n_params\n",
        "print(f\"model params={n_params:,}\")\n",
        "\n",
        "tokens_per_step = BATCH * SEQ * ACCUM\n",
        "# WSD horizon \u2248 tokens we hope to see in HOURS; schedule is extendable.\n",
        "est_tok_s = 180_000 if device.type == \"cuda\" else 25_000\n",
        "horizon_steps = max(2000, int((est_tok_s * HOURS * 3600) / tokens_per_step))\n",
        "optimizer = build_optimizer(model, \"adamw\", lr=LR, weight_decay=0.1, betas=(0.9, 0.95))\n",
        "scheduler = build_scheduler(\n",
        "    optimizer,\n",
        "    \"wsd\",\n",
        "    total_steps=horizon_steps,\n",
        "    warmup_steps=resolve_warmup(0.03, horizon_steps),\n",
        "    decay_ratio=0.20,\n",
        "    decay_shape=\"sqrt\",\n",
        ")\n",
        "\n",
        "ckpt_dir = WORK / \"checkpoints\"\n",
        "ckpt_dir.mkdir(parents=True, exist_ok=True)\n",
        "drive_ckpt = DRIVE_ROOT / \"checkpoints\" if IN_COLAB else None\n",
        "if drive_ckpt:\n",
        "    drive_ckpt.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "start_step = 0\n",
        "tokens_seen = 0\n",
        "resume = ckpt_dir / \"latest.pt\"\n",
        "if drive_ckpt and (drive_ckpt / \"latest.pt\").exists() and not resume.exists():\n",
        "    shutil.copy2(drive_ckpt / \"latest.pt\", resume)\n",
        "if resume.exists():\n",
        "    blob = torch.load(resume, map_location=device, weights_only=False)\n",
        "    model.load_state_dict(blob[\"model\"])\n",
        "    optimizer.load_state_dict(blob[\"optimizer\"])\n",
        "    scheduler.load_state_dict(blob[\"scheduler\"])\n",
        "    start_step = int(blob[\"step\"])\n",
        "    tokens_seen = int(blob[\"tokens_seen\"])\n",
        "    print(f\"resumed step={start_step} tokens={tokens_seen:,}\")\n",
        "\n",
        "\n",
        "def save_ckpt(step: int, loss: float) -> None:\n",
        "    payload = {\n",
        "        \"step\": step,\n",
        "        \"tokens_seen\": tokens_seen,\n",
        "        \"loss\": loss,\n",
        "        \"model\": model.state_dict(),\n",
        "        \"optimizer\": optimizer.state_dict(),\n",
        "        \"scheduler\": scheduler.state_dict(),\n",
        "        \"arch\": \"dense_1_4m\",\n",
        "        \"params\": n_params,\n",
        "        \"vocab\": tok.vocab_size,\n",
        "        \"mix\": MIX,\n",
        "    }\n",
        "    path = ckpt_dir / \"latest.pt\"\n",
        "    torch.save(payload, path)\n",
        "    torch.save(payload, ckpt_dir / f\"step_{step:06d}.pt\")\n",
        "    model.save_pretrained(ckpt_dir / \"model\")\n",
        "    tok.save(ckpt_dir / \"model\" / \"tokenizer.json\")\n",
        "    if drive_ckpt:\n",
        "        shutil.copy2(path, drive_ckpt / \"latest.pt\")\n",
        "        shutil.copy2(ckpt_dir / f\"step_{step:06d}.pt\", drive_ckpt / f\"step_{step:06d}.pt\")\n",
        "        model_drive = drive_ckpt / \"model\"\n",
        "        if model_drive.exists():\n",
        "            shutil.rmtree(model_drive)\n",
        "        shutil.copytree(ckpt_dir / \"model\", model_drive)\n",
        "        tok.save(drive_ckpt / \"tokenizer.json\")\n",
        "        meta = {\n",
        "            \"step\": step,\n",
        "            \"tokens_seen\": tokens_seen,\n",
        "            \"loss\": loss,\n",
        "            \"params\": n_params,\n",
        "            \"hours\": HOURS,\n",
        "            \"mix\": MIX,\n",
        "        }\n",
        "        (drive_ckpt / \"train_meta.json\").write_text(json.dumps(meta, indent=2))\n",
        "    print(f\"  saved checkpoint @ step {step} \u2192 {path}\" + (f\" + {drive_ckpt}\" if drive_ckpt else \"\"))\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# 6) Token buffer + train loop (wall-clock capped)\n",
        "# ---------------------------------------------------------------------------\n",
        "buffer: list[int] = []\n",
        "\n",
        "\n",
        "def refill(min_tokens: int = STREAM_BUFFER_TOKENS) -> None:\n",
        "    while len(buffer) < min_tokens:\n",
        "        ids = encode(next_doc())\n",
        "        if not ids:\n",
        "            continue\n",
        "        buffer.extend(ids)\n",
        "        buffer.append(tok.eos_id)\n",
        "\n",
        "\n",
        "def sample_batch():\n",
        "    refill(BATCH * SEQ * 4)\n",
        "    xs, ys = [], []\n",
        "    for _ in range(BATCH):\n",
        "        if len(buffer) < SEQ + 1:\n",
        "            refill()\n",
        "        # pop a contiguous window from the front for approximate streaming order\n",
        "        chunk = buffer[: SEQ + 1]\n",
        "        del buffer[: SEQ // 2]  # 50% overlap stride keeps buffer fresh\n",
        "        xs.append(chunk[:SEQ])\n",
        "        ys.append(chunk[1 : SEQ + 1])\n",
        "    return (\n",
        "        torch.tensor(xs, dtype=torch.long, device=device),\n",
        "        torch.tensor(ys, dtype=torch.long, device=device),\n",
        "    )\n",
        "\n",
        "\n",
        "def soft_kl_batch(n: int = 8) -> torch.Tensor:\n",
        "    if not aligned_soft:\n",
        "        return torch.zeros((), device=device)\n",
        "    total = torch.zeros((), device=device)\n",
        "    for i in range(n):\n",
        "        step = aligned_soft[(start_step + i) % len(aligned_soft)]\n",
        "        if len(step.context_ids) < 1:\n",
        "            continue\n",
        "        ctx = torch.tensor(step.context_ids[-SEQ:], dtype=torch.long, device=device).unsqueeze(0)\n",
        "        logits = model(ctx)[0, -1]\n",
        "        total = total + soft_kl_loss(logits, step.token_ids, step.probs)\n",
        "    return total / max(n, 1)\n",
        "\n",
        "\n",
        "model.train()\n",
        "t0 = time.perf_counter()\n",
        "deadline = t0 + HOURS * 3600\n",
        "losses: list[float] = []\n",
        "step = start_step\n",
        "print(f\"training up to {HOURS}h  (~{horizon_steps} sched steps, {tokens_per_step:,} tok/step)\")\n",
        "\n",
        "try:\n",
        "    while time.perf_counter() < deadline:\n",
        "        step += 1\n",
        "        optimizer.zero_grad(set_to_none=True)\n",
        "        loss_acc = 0.0\n",
        "        for _ in range(ACCUM):\n",
        "            x, y = sample_batch()\n",
        "            out = model.forward_with_loss(x, y)\n",
        "            (out.loss / ACCUM).backward()\n",
        "            loss_acc += float(out.loss.detach())\n",
        "            tokens_seen += int(x.numel())\n",
        "        if step % SOFT_KL_EVERY == 0:\n",
        "            skl = soft_kl_batch()\n",
        "            (SOFT_KL_WEIGHT * skl).backward()\n",
        "            loss_acc += SOFT_KL_WEIGHT * float(skl.detach())\n",
        "        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
        "        optimizer.step()\n",
        "        scheduler.step()\n",
        "        losses.append(loss_acc / ACCUM)\n",
        "        if step % 50 == 0 or step == start_step + 1:\n",
        "            elapsed = time.perf_counter() - t0\n",
        "            print(\n",
        "                f\"step {step:>6}  loss {sum(losses[-50:]) / len(losses[-50:]):.4f}  \"\n",
        "                f\"tokens {tokens_seen/1e6:.1f}M  {tokens_seen / max(elapsed, 1e-6):,.0f} tok/s  \"\n",
        "                f\"eta_left {(deadline - time.perf_counter()) / 3600:.2f}h\",\n",
        "                flush=True,\n",
        "            )\n",
        "        if step % SAVE_EVERY == 0:\n",
        "            save_ckpt(step, sum(losses[-50:]) / len(losses[-50:]))\n",
        "except KeyboardInterrupt:\n",
        "    print(\"interrupted \u2014 saving\u2026\")\n",
        "\n",
        "final_loss = sum(losses[-50:]) / max(len(losses[-50:]), 1) if losses else float(\"nan\")\n",
        "save_ckpt(step, final_loss)\n",
        "elapsed_h = (time.perf_counter() - t0) / 3600\n",
        "print(f\"DONE steps={step} tokens={tokens_seen:,} loss={final_loss:.4f} hours={elapsed_h:.2f}\")\n",
        "\n",
        "# ---------------------------------------------------------------------------\n",
        "# 7) Smoke: generate a few soft-QA answers + a story prompt\n",
        "# ---------------------------------------------------------------------------\n",
        "model.eval()\n",
        "from minimodel.inference.sampling import generate_text\n",
        "\n",
        "prompts = [e[\"prompt\"] for e in soft_entries[:8]] + [\"Once upon a time,\", \"The capital of France is\"]\n",
        "print(\"\\n=== smoke generations ===\")\n",
        "for p in prompts:\n",
        "    try:\n",
        "        text = generate_text(model, tok, p, max_new_tokens=48, temperature=0.7, top_k=40)\n",
        "    print(f\">> {p!r}\\n{text}\\n\")\n",
        "\n",
        "summary = {\n",
        "    \"params\": n_params,\n",
        "    \"steps\": step,\n",
        "    \"tokens_seen\": tokens_seen,\n",
        "    \"final_loss\": final_loss,\n",
        "    \"hours\": elapsed_h,\n",
        "    \"mix\": MIX,\n",
        "    \"lr\": LR,\n",
        "    \"seq\": SEQ,\n",
        "    \"device\": str(device),\n",
        "}\n",
        "(WORK / \"run_summary.json\").write_text(json.dumps(summary, indent=2))\n",
        "if IN_COLAB:\n",
        "    shutil.copy2(WORK / \"run_summary.json\", DRIVE_ROOT / \"run_summary.json\")\n",
        "print(\"summary:\", json.dumps(summary, indent=2))\n",
        "print(\"Drive folder:\" if IN_COLAB else \"Local work:\", DRIVE_ROOT if IN_COLAB else WORK)\n",
        "\n"
      ],
      "execution_count": null,
      "outputs": [],
      "id": "cell0"
    }
  ]
}
