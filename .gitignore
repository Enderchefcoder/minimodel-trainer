# Keep tiny fixtures that tests depend on
!tests/fixtures/**

# Research: keep code, reports, and small result JSONs; exclude big downloads.
# (The generic `data/` rule above also matches research/data/ and
# src/vision/data/, so re-include those package trees explicitly.)
!research/data/
research/data/train/
research/data/eval/
!research/data/results/
!research/data/results/**
!research/data/corpus/
!research/data/corpus/**
!src/vision/data/
!src/vision/data/**
# Re-includes can resurrect caches; keep them ignored.
src/vision/data/**/__pycache__/
research/baselines/glint2/*.pt
research/baselines/glint2/tokenizer.json
research/experiments/runs/
research/artifacts/
*.pt

